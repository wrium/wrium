{
  "name": "wrium",
  "version": "1.0.0",
  "description": "MiniVue: A minimal reactive framework inspired by Vue.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/1.0.0/wrium.umd.js",
  "module": "./dist/1.0.0/wrium.es.js",
  "exports": {
    ".": {
      "types": "./dist/types/wrium.d.ts",
      "import": "./dist/1.0.0/wrium.es.js",
      "require": "./dist/1.0.0/wrium.umd.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wrium/wrium.git"
  },
  "homepage": "https://github.com/wrium/wrium",
  "devDependencies": {
    "@vitest/coverage-v8": "4.0.15",
    "@vitest/ui": "4.0.15",
    "jsdom": "^27.3.0",
    "terser": "^5.44.1",
    "typescript": "^7.0.2",
    "vite": "^7.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "wrium",
    "reactivity",
    "minimal-js",
    "javascript-reactive"
  ],
  "author": "Benjamin Khalife",
  "license": "MIT"
}